<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the daily SNIIM update on macOS.

  Install:
    1. Edit the two REPLACE_ME paths below to the absolute path of this project.
    2. cp scripts/mx.sniim.update.plist ~/Library/LaunchAgents/
    3. launchctl load  ~/Library/LaunchAgents/mx.sniim.update.plist
    4. launchctl start mx.sniim.update          # test it once, now

  Check on it:
    launchctl list | grep sniim
    tail -f logs/cron.log

  Remove:
    launchctl unload ~/Library/LaunchAgents/mx.sniim.update.plist

  Runs at 19:30 local time. SNIIM publishes on weekday afternoons, so an
  evening run picks up the same day. RunAtLoad is false on purpose: you do not
  want a multi-minute scrape firing every time you log in.

  Unlike cron, launchd fires a missed job as soon as the Mac wakes up, so a
  closed laptop only delays the run rather than skipping the day. The update is
  idempotent and uses a 14-day trailing window, so even a skipped week self-heals.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>mx.sniim.update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_ME/scripts/daily_update.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPLACE_ME</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPLACE_ME/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_ME/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
